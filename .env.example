# Node.js 24.14+; server scripts load .env when present.
PLANTBOX_HOST=127.0.0.1
PLANTBOX_PORT=3001
PLANTBOX_DB=data/warehouse.sqlite
# Required (24+ random characters) before binding outside loopback.
# Enter this credential in the operations page; never put it in a VITE_* variable.
# PLANTBOX_API_TOKEN=
PLANTBOX_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
